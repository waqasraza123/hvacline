APP_ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
WORKER_NAME=local-worker
IDEMPOTENCY_RETENTION_HOURS=24
CONVERSATION_AI_ENABLED=false
CONVERSATION_PROVIDER=elevenlabs
DEVELOPMENT_ACTOR_USER_ID=00000000-0000-4000-8000-000000000002
CONVERSATION_MAX_DURATION_SECONDS=180
CONVERSATION_DAILY_SESSION_LIMIT=10
CONVERSATION_CONFIRMATION_WINDOW_MINUTES=30
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PRIVACY_CONFIRMED=false
LOCAL_WHISPER_COMMAND=whisper-cli
LOCAL_WHISPER_MODEL_PATH=.local/models/ggml-base.en.bin
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_OLLAMA_MODEL=llama3.2:3b
LOCAL_PIPER_MODEL_PATH=.local/models/piper/en_US-lessac-medium.onnx
DATABASE_URL=postgresql+psycopg://user:password@pooled-host/database?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://user:password@direct-host/database?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost/insurance_operations_test
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DEMO_SANDBOX_ENABLED=false
DEMO_ADMIN_TOKEN=
DEMO_INBOUND_NUMBER_E164=
DEMO_TRANSFER_DESTINATION_E164=
DEMO_RESULT_TTL_MINUTES=15

TELEPHONY_PROVIDER_ENABLED=false
# disabled, twilio (legacy default), or telnyx_sip; the enable flag gates execution.
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_INBOUND_WEBHOOK_URL=
TWILIO_TRANSFER_CALLBACK_URL=
ELEVENLABS_PHONE_AGENT_ID=
ELEVENLABS_PHONE_TOOL_SECRET=
# Telnyx SIP only: separate random secret, 32–512 characters, stored server-side.
ELEVENLABS_PHONE_INITIATION_SECRET=
ELEVENLABS_POST_CALL_WEBHOOK_SECRET=

# Outbound portfolio demo; independent of inbound calling. Keep website off until
# one real outbound call has passed acceptance. Transfer is optional and separately verified.
OUTBOUND_DEMO_ENABLED=false
OUTBOUND_DEMO_WEBSITE_ENABLED=false
OUTBOUND_DEMO_LIVE_VERIFIED=false
OUTBOUND_DEMO_TRANSFER_ENABLED=false
OUTBOUND_DEMO_TRANSFER_VERIFIED=false
OUTBOUND_DEMO_CARRIER_LIMIT_CONFIRMED=false
OUTBOUND_DEMO_AGENT_ID=
OUTBOUND_DEMO_PHONE_NUMBER_ID=
OUTBOUND_DEMO_NUMBER_POLICY=allowlist
# Server-only, comma-separated E.164 numbers whose owners approved test calls.
# Required only for allowlist; consented_us supports website callbacks with transfer off.
OUTBOUND_DEMO_ALLOWED_NUMBERS=
OUTBOUND_DEMO_HUMAN_NUMBER=
# Dedicated stable >=32-character secret, shared only by API and Next server.
OUTBOUND_DEMO_SECRET=
# Dedicated ElevenLabs HMAC signing secret, different from the bridge secret.
OUTBOUND_DEMO_WEBHOOK_SECRET=
OUTBOUND_DEMO_DAILY_LIMIT=5
OUTBOUND_DEMO_NUMBER_DAILY_LIMIT=1
OUTBOUND_DEMO_ACCOUNT_DAILY_LIMIT=1
# Website-only phone verification; use a dedicated Telnyx Verify profile with six-digit SMS codes.
TELNYX_VERIFY_API_KEY=
TELNYX_VERIFY_PROFILE_ID=
OUTBOUND_DEMO_SMS_DAILY_LIMIT=20
OUTBOUND_DEMO_SMS_ACCOUNT_DAILY_LIMIT=3
OUTBOUND_DEMO_SMS_NUMBER_DAILY_LIMIT=3
OUTBOUND_DEMO_SMS_COOLDOWN_SECONDS=60
OUTBOUND_DEMO_SMS_TTL_SECONDS=300
OUTBOUND_DEMO_COOLDOWN_SECONDS=300
OUTBOUND_DEMO_MAX_DURATION_SECONDS=180
OUTBOUND_DEMO_RINGING_SECONDS=25
PHONE_MAX_DURATION_SECONDS=180
PHONE_CONFIRMATION_WINDOW_MINUTES=30

# Direct inbound WhatsApp voice only; independent of TELEPHONY_PROVIDER_ENABLED.
WHATSAPP_ENABLED=false
WHATSAPP_AGENCY_ID=
WHATSAPP_ACTOR_USER_ID=
ELEVENLABS_WHATSAPP_AGENT_ID=
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=
ELEVENLABS_WHATSAPP_INIT_SECRET=
ELEVENLABS_WHATSAPP_TOOL_SECRET=
ELEVENLABS_WHATSAPP_SESSION_SECRET=
ELEVENLABS_WHATSAPP_POST_CALL_SECRET=
ELEVENLABS_WHATSAPP_PRIVACY_CONFIRMED=false
# Customer accounts remain fictional-only and disabled until owner verification.
CUSTOMER_PORTAL_ENABLED=false
CUSTOMER_PORTAL_SECRET=
CUSTOMER_MFA_ENCRYPTION_KEY=
HOMEPAGE_CHAT_ENABLED=false
HOMEPAGE_CHAT_DAILY_LIMIT=20
HOMEPAGE_CHAT_CONCURRENT_LIMIT=1
CUSTOMER_MAX_ACTIVE_APPOINTMENTS=1
CUSTOMER_MAX_BOOKING_CHANGES=1
CUSTOMER_MEMORY_ENABLED=false
CUSTOMER_MEMORY_RETENTION_DAYS=90
CUSTOMER_MEMORY_CONTEXT_CHARACTERS=1200

# Google Calendar and booking email are opt-in, fictional-data development features.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDAR_TOKEN_ENCRYPTION_KEY=
BOOKING_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BOOKING_EMAIL_FROM=
BOOKING_REMINDER_HOURS=24
WORKER_POLL_SECONDS=30
# Dedicated job-function secret; never expose it through NEXT_PUBLIC_ variables.
BOOKING_JOBS_SECRET=
